# Google Calendar API credentials
# Get these from: https://console.cloud.google.com/
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# Google Calendar IDs (found in calendar settings → "Integrate calendar")
# Use 'primary' for the main/default calendar
VITE_CALENDAR_MEMBER1=primary
VITE_CALENDAR_MEMBER2=
VITE_CALENDAR_MEMBER3=
VITE_CALENDAR_FAMILY=
